# Production template — copy to server/.env on EC2
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://yourproject.vercel.app

# PostgreSQL / Amazon RDS
DATABASE_URL="postgresql://postgres:CHANGE_ME@shopindia-db.cxxxx.us-east-1.rds.amazonaws.com:5432/shopindia?schema=public"

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxx
COGNITO_CLIENT_ID=your-client-id

# Amazon S3 / CloudFront
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=shopindia-assets
CLOUDFRONT_DOMAIN=https://dxxxxx.cloudfront.net

# JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING