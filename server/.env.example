# Node Server Environment Variables
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database - PostgreSQL / Amazon RDS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopindia?schema=public"

# Auth - Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_examplePoolId
COGNITO_CLIENT_ID=exampleClientId123456

# Storage - Amazon S3 & CloudFront
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=shopindia-assets
CLOUDFRONT_DOMAIN=https://d12345example.cloudfront.net

# JWT Fallback (Development only)
JWT_SECRET=shopindia_super_secret_change_in_production
